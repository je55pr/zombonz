# Optional ICE deployment settings.
# Leave these unset to use Zombonz's built-in Google STUN defaults and no TURN relay.

# Comma- or whitespace-separated STUN URLs.
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN fallback. Both username and credential are required when VITE_TURN_URLS is set.
# VITE_TURN_URLS=turn:relay.example.com:3478?transport=udp,turns:relay.example.com:5349?transport=tcp
# VITE_TURN_USERNAME=temporary-user
# VITE_TURN_CREDENTIAL=temporary-password
