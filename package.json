{
  "name": "zombonz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-bootstrap-manifest.mjs && vite",
    "build": "node scripts/generate-bootstrap-manifest.mjs && tsc --noEmit && vite build",
    "build:pages": "node scripts/generate-bootstrap-manifest.mjs && vite build --base=/zombonz/",
    "generate:asset-manifest": "node scripts/generate-bootstrap-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "validate:maps": "node scripts/validate-maps.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run generate:asset-manifest && npm run typecheck && npm run validate:maps && npm test && npm run build",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
