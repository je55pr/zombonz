{
  "name": "zombonz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-bootstrap-manifest.mjs && vite",
    "build": "node scripts/generate-bootstrap-manifest.mjs && tsc --noEmit && vite build",
    "build:pages": "node scripts/generate-bootstrap-manifest.mjs && vite build --base=/zombonz/",
    "generate:asset-manifest": "node scripts/generate-bootstrap-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "validate:maps": "node scripts/validate-maps.mjs",
    "editor:setup": "node scripts/godot-map-editor.mjs setup",
    "editor:check": "node scripts/godot-map-editor.mjs check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test --config=playwright.config.ts",
    "check": "npm run generate:asset-manifest && npm run typecheck && npm run validate:maps && npm test && npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "server:dev": "node scripts/server.mjs dev",
    "server:deploy": "node scripts/server.mjs deploy"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.144.0"
  }
}
